{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF check_skill_workshop_loaded.sh \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check_skill_workshop_loaded.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF mark_skill_workshop_loaded.sh \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/mark_skill_workshop_loaded.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF mark_skill_workshop_loaded_from_prompt.sh \"$CLAUDE_PROJECT_DIR/.claude/settings.json\" || bash \"${CLAUDE_PLUGIN_ROOT}/hooks/mark_skill_workshop_loaded_from_prompt.sh\""
          }
        ]
      }
    ]
  }
}
